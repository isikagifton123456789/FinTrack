{
  "name": "fintrack",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c yellow,cyan \"npm:dev --workspace backend\" \"npm:dev --workspace frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm test --workspace frontend && npm test --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "seed": "npm run seed --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

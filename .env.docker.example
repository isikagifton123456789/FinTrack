# Replace both values with long random alphanumeric strings before starting.
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DEMO_EMAIL=analyst@finnet.demo
DEMO_PASSWORD=replace-with-a-unique-demo-password

FRONTEND_PORT=8080
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Optional Gmail SMTP settings. Email-based account actions need these.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_FROM_NAME=FinTrack
EMAIL_FROM_ADDRESS=
